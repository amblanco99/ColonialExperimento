export type SeccionActiva = 'inicio' | 'base-de-datos' | 'tiempo' | 'personas' | 'about';

interface Props {
  active?: SeccionActiva;
}

const { active } = Astro.props;

// BASE_URL ya termina en '/', así que los segmentos van SIN barra inicial.
// Con barra saldría '//', el mismo error que arrastran las 17 rutas de datos.
const base = import.meta.env.BASE_URL;

const enlaces = [
  { id: 'inicio', texto: 'Inicio', href: `${base}index.html` },
  { id: 'base-de-datos', texto: 'Tablas y filtros', href: `${base}base-de-datos/index.html` },
  { id: 'tiempo', texto: 'Tiempo', href: `${base}tiempo/index.html` },
  { id: 'personas', texto: 'Composicion social', href: `${base}personas/index.html` },
  { id: 'about', texto: 'Sobre el proyecto', href: `${base}about/index.html` },
] as const satisfies ReadonlyArray<{ id: SeccionActiva; texto: string; href: string }>;
---

<nav class="topnav">
  <a href={`${base}index.html`} class="logo">Crimen y Justicia en el nuevo reino de granada</a>

  <button
    type="button"
    class="nav-toggle"
    aria-controls="nav-menu"
    aria-expanded="false"
    aria-label="Abrir menú"
  >
    <span class="nav-toggle-icono" aria-hidden="true"></span>
  </button>

  <div class="nav-links" id="nav-menu">
    {
      enlaces.map((enlace) => (
        <a href={enlace.href} aria-current={active === enlace.id ? 'page' : undefined}>
          {enlace.texto}
        </a>
      ))
    }
  </div>
</nav>

<script>
  import { initNavMenu } from '../scripts/ui/navMenu.js';

  initNavMenu();
</script>
