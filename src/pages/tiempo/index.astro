---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Cadena de tiempomain.js, en el mismo orden. La global la pone BaseLayout.
import '../../styles/pages/tooltips.scss';
import '../../styles/pages/botones.scss';
import '../../styles/pages/paneles-filtro.scss';
import '../../styles/pages/mapa.scss';
import '../../styles/pages/crimenesPorTipo.scss';
import '../../styles/pages/lineaTiempoCasos.scss';
import 'lenis/dist/lenis.css';
const base = import.meta.env.BASE_URL
---

<BaseLayout title="Tiempo" active="tiempo">
  <main class="container">
    <h1 class="section-mainTitle">Cambio de los crimenes en el tiempo y espacio </h1>

    <div class="mapa-selector-vista">
      <button type="button" id="btn-informacion" class="btn-mapa-vista mapa-selector-vista-informacion">
        Información
      </button>
      <div class="mapa-selector-vista-grupo">
        <button type="button" id="btn-vista-lugar" class="btn-mapa-vista btn-mapa--activo">Lugar</button>
        <button type="button" id="btn-vista-tiempo" class="btn-mapa-vista">Línea de tiempo</button>
        <button type="button" id="btn-vista-crimenes" class="btn-mapa-vista">Crimenes</button>
      </div>
      <button type="button" id="btn-instrucciones" class="btn-mapa-vista mapa-selector-vista-instrucciones">
        Instrucciones
      </button>
    </div>

    <div id="panel-instrucciones" class="mapa-tarjeta mapa-vista--oculta">
      <button type="button" class="mapa-tarjeta-cerrar" id="cerrar-instrucciones" aria-label="Cerrar instrucciones">×</button>
      <div class="mapa-tarjeta-titulo">Instrucciones</div>
      <div class="mapa-tarjeta-divisor"></div>
      <p class="mapa-tarjeta-parrafo">
        Para navegar en esta sección tienes tres opciones: Lugar, Línea del tiempo y crimenes.
      </p>
      <p class="mapa-tarjeta-parrafo">
        En <b>Lugar</b> está el mapa de las provincias (1808). Puedes hacer clic en los puntos para ver los lugares específicos, lo que abrirá más información sobre el lugar. Prueba comparar varios lugares a la par.
      </p>
      <p class="mapa-tarjeta-parrafo">
        En <b>Línea del tiempo</b> tienes dos vistas, puedes navegar por línea o rueda. En la vista de línea puedes observar el desarrollo de los casos a lo largo de los años. Por otro lado, la rueda te permite explorar año a año, haz clic en uno de los círculos para detallar cada caso.
      </p>
      <p class="mapa-tarjeta-parrafo">
        Los <b>crimenes</b> están organizados de los más frecuentes a los menos. Haz clic en una barra y tendrás más detalles. Puedes seleccionar varios crimenes a la vez o puedes ver el top de crimenes de cada lugar.
      </p>
      <p class="mapa-tarjeta-parrafo">¡Explora!</p>
    </div>

    <div id="panel-informacion" class="mapa-tarjeta mapa-vista--oculta">
      <button type="button" class="mapa-tarjeta-cerrar" id="cerrar-informacion" aria-label="Cerrar información">×</button>
      <div class="mapa-tarjeta-titulo">Información importante</div>
      <div class="mapa-tarjeta-divisor"></div>
      <p>
       Para comprender las gráficas recuerda: <br>
      Un <b>caso</b> es uno o más documentos que se refieren al mismo proceso judicial. Un caso puede contener varios crímenes. Cada <b> crimen</b> se ha clasificado con una observación analítica del equipo. <br> <a href={`${base}about/index.html`}>Más información.</a> </p>
    </div>

    <div id="panel-filtros" class="controles"></div>

    <div id="vista-lugar">
      <div class="dashboard-visualizaciones">
        <div id="mapa-contenedor"></div>
        <div id="crimenesChart"></div>
      </div>
    </div>

    <div id="vista-tiempo" class="mapa-vista--oculta">
      <div class="mapa-tarjeta">
        <div class="mapa-tarjeta-encabezado">
          <div class="mapa-tarjeta-titulo" id="lineaTiempoCasosTitulo">Casos a lo largo de los años</div>
          <div class="mapa-tarjeta-subtitulo" id="lineaTiempoCasosSubtitulo">Cada línea suma los casos por año según su tipo de proceso. </div>
        </div>
        <div class="mapa-tarjeta-divisor"></div>
        <div id="lineaTiempoCasosContenedor"></div>
      </div>
    </div>

    <div id="vista-crimenes" class="mapa-vista--oculta mapa-vista-crimenes">
      <div class="mapa-crimenes-layout">
        <div class="mapa-crimenes-col-izquierda">
          <div class="mapa-tarjeta mapa-tarjeta--compacta">
            <div class="mapa-tarjeta-encabezado">
              <div class="mapa-tarjeta-titulo">Top de crimenes</div>
              <div class="mapa-tarjeta-subtitulo">
               Aquí puede observar los crimenes de los más frecuentes a los menos frecuentes a lo largo de los años.
               Ajuste el rango de fecha para observar los cambios en cada periodo. Haga clic en cada barra para conocer más. 
              </div>
            </div>
            <div class="mapa-tarjeta-divisor"></div>
            <div id="crimenesPorTipo"></div>
          </div>
        </div>

        <div class="mapa-crimenes-col-derecha mapa-crimenes-col-derecha--oculta">
          <div class="mapa-tarjeta mapa-tarjeta--compacta">
            <div class="mapa-tarjeta-encabezado">
              <div class="mapa-tarjeta-titulo">Evolución del crimen</div>
              <div class="mapa-tarjeta-subtitulo">
                Si quiere comparar, seleccione otros crimenes. Si quiere ver algún subcrimen a lo largo del tiempo, seleccione uno de la dona. 
              </div>
            </div>
            <div class="mapa-tarjeta-divisor"></div>
            <div id="crimenesSpikeContenedor"></div>
          </div>

          <div class="mapa-tarjeta mapa-tarjeta--compacta">
            <div class="mapa-tarjeta-encabezado">
              <div class="mapa-tarjeta-titulo">Subcrimenes</div>
              <div class="mapa-tarjeta-subtitulo">
                Del crimen fijado
              </div>
            </div>
            <div class="mapa-tarjeta-divisor"></div>
            <div id="crimenesDonutContenedor"></div>
          </div>
        </div>
      </div>

    </div>

    <script>
      import { inicializarDashboard } from '../../scripts/charts/TiempoCrimenesMapa.js';
      import { crearCrimenesPorTipo } from '../../scripts/charts/CrimenesPorTipo.js';
      import { crearLineaTiempoCasos } from '../../scripts/charts/LineaTiempoCasos.js';

      // El botón "Ver en el mapa" de LineaTiempoCasos.ts vive en otra vista;
      // llega hasta acá por este hook global en vez de importar mostrarVista
      // directamente, mismo patrón de desacople que usan los demás módulos
      // (ver __obtenerFiltrosCrimenesPorTipo en TiempoCrimenesMapa.ts).
      declare global {
        interface Window {
          __irAVistaLugar?: () => void;
        }
      }

      inicializarDashboard();

      type Vista = 'lugar' | 'tiempo' | 'crimenes';

      const vistas: Record<Vista, { boton: HTMLElement; contenedor: HTMLElement }> = {
        lugar: {
          boton: document.getElementById('btn-vista-lugar')!,
          contenedor: document.getElementById('vista-lugar')!,
        },
        tiempo: {
          boton: document.getElementById('btn-vista-tiempo')!,
          contenedor: document.getElementById('vista-tiempo')!,
        },
        crimenes: {
          boton: document.getElementById('btn-vista-crimenes')!,
          contenedor: document.getElementById('vista-crimenes')!,
        },
      };

      // Cada vista, salvo "Lugar" (visible desde la carga inicial de la
      // página), crea sus widgets recién la primera vez que el usuario entra
      // a ella, no antes.
      let vistaTiempoInicializada = false;
      let vistaCrimenesInicializada = false;

      function mostrarVista(vista: Vista) {
        (Object.keys(vistas) as Vista[]).forEach((clave) => {
          const activa = clave === vista;
          vistas[clave].contenedor.classList.toggle('mapa-vista--oculta', !activa);
          vistas[clave].boton.classList.toggle('btn-mapa--activo', activa);
        });

        // El filtro de Lugar no aplica en "Línea de tiempo" (esa vista ya no
        // agrupa por lugar); se oculta solo ahí, sigue disponible en "Lugar"
        // y "crimenes".
        document
          .getElementById('filtro-lugar-wrap')
          ?.classList.toggle('mapa-vista--oculta', vista === 'tiempo');

        // El filtro de Provincia solo hace falta en "Lugar" (el único que lo
        // usa para acotar el mapa/combo de Lugar); se oculta en las demás.
        document
          .getElementById('filtro-provincia-wrap')
          ?.classList.toggle('mapa-vista--oculta', vista !== 'lugar');

        // El filtro de Subcrimen ya no se muestra en ninguna vista (ver
        // comboSubcrimen en TiempoCrimenesMapa.ts, que lo arranca oculto y
        // nada lo vuelve a mostrar) — no hace falta alternarlo acá.

        if (vista === 'tiempo' && !vistaTiempoInicializada) {
          vistaTiempoInicializada = true;
          crearLineaTiempoCasos('lineaTiempoCasosContenedor');
        }
        if (vista === 'crimenes' && !vistaCrimenesInicializada) {
          vistaCrimenesInicializada = true;
          crearCrimenesPorTipo({
            barrasId: 'crimenesPorTipo',
            spikeId: 'crimenesSpikeContenedor',
            donutId: 'crimenesDonutContenedor',
          });
        }
      }

      window.__irAVistaLugar = () => mostrarVista('lugar');

      vistas.lugar.boton.addEventListener('click', () => mostrarVista('lugar'));
      vistas.tiempo.boton.addEventListener('click', () => mostrarVista('tiempo'));
      vistas.crimenes.boton.addEventListener('click', () => mostrarVista('crimenes'));

      // Paneles aparte de las vistas de arriba (Instrucciones, Información):
      // no ocultan ni reemplazan la vista activa, solo se abren/cierran
      // encima del selector de vistas. Misma lógica para todos: botón que
      // alterna, botón × para cerrar, clic fuera y Escape. Al abrir uno se
      // cierran los demás para que no queden dos paneles apilados.
      const panelesDesplegables: Array<(abierto: boolean) => void> = [];

      function configurarPanelDesplegable(botonId: string, panelId: string, cerrarId: string) {
        const boton = document.getElementById(botonId)!;
        const panel = document.getElementById(panelId)!;
        const botonCerrar = document.getElementById(cerrarId);

        const estaAbierto = () => !panel.classList.contains('mapa-vista--oculta');

        function establecer(abierto: boolean) {
          if (abierto) {
            panelesDesplegables.forEach((otro) => {
              if (otro !== establecer) otro(false);
            });
          }
          panel.classList.toggle('mapa-vista--oculta', !abierto);
          boton.classList.toggle('btn-mapa--activo', abierto);
        }
        panelesDesplegables.push(establecer);

        boton.addEventListener('click', (e) => {
          e.stopPropagation();
          establecer(!estaAbierto());
        });

        botonCerrar?.addEventListener('click', () => establecer(false));

        // Cerrar al hacer clic fuera del panel
        document.addEventListener('click', (e) => {
          if (!estaAbierto()) return;
          const target = e.target as Node;
          if (!panel.contains(target) && !boton.contains(target)) establecer(false);
        });

        // Cerrar con Escape
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') establecer(false);
        });
      }

      configurarPanelDesplegable('btn-instrucciones', 'panel-instrucciones', 'cerrar-instrucciones');
      configurarPanelDesplegable('btn-informacion', 'panel-informacion', 'cerrar-informacion');
    </script>
  </main>
</BaseLayout>
