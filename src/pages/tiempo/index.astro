---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Cadena de tiempomain.js, en el mismo orden. La global la pone BaseLayout.
import '../../styles/pages/tooltips.scss';
import '../../styles/pages/botones.scss';
import '../../styles/pages/paneles-filtro.scss';
import '../../styles/pages/mapa.scss';
import '../../styles/pages/crimenesPorTipo.scss';

// Tres cosas que este módulo hace y ninguna otra página necesita:
//
// 1. TiempoCrimenesMapa.js:237 hace document.querySelector("main.container") y
//    le añade la clase mapa-main-ancho en tiempo de ejecución. Por eso el <main>
//    tiene que llevar class="container": si no, el selector no encuentra nada,
//    no hay error y la página se queda estrecha.
// 2. #panel-filtros y #columna-visualizaciones siguen un patrón buscar-o-crear
//    (líneas 265-275). #panel-filtros va en el marcado, así que se encuentra;
//    #columna-visualizaciones no, así que lo crea el módulo.
// 3. #mapa-contenedor es obligatorio: la línea 230 hace return si falta.
//
// Los estilos en línea del contenedor de visualizaciones se copian literales:
// los min-width de 350 y 450 son los que fuerzan el salto de línea, y mapa.css
// no los duplica.
//
// El original cerraba </main> dos veces (líneas 15 y 17). Se elimina el
// duplicado, que era una etiqueta desbalanceada.
---

<BaseLayout title="Tiempo" active="tiempo">
  <main class="container">
    <h1 class="section-mainTitle">Tiempo, lugares y crímenes</h1>

    <div class="mapa-selector-vista">
      <button type="button" id="btn-vista-lugar" class="btn-mapa-vista btn-mapa--activo">Lugar</button>
      <button type="button" id="btn-vista-crimenes" class="btn-mapa-vista">Crímenes</button>
    </div>

    <div id="panel-filtros" class="controles"></div>

    <div id="vista-lugar">
      <div class="dashboard-visualizaciones" style="display: flex; gap: 20px; flex-wrap: wrap;">
        <div id="mapa-contenedor" style="flex: 1; min-width: 350px;"></div>
        <div id="crimenesChart" style="flex: 1; min-width: 450px;"></div>
      </div>
    </div>

    <div id="vista-crimenes" class="mapa-vista--oculta mapa-vista-crimenes">
      <div class="mapa-tarjeta mapa-tarjeta--compacta">
        <div class="mapa-tarjeta-encabezado">
          <div class="mapa-tarjeta-titulo">Crímenes por tipo</div>
          <div class="mapa-tarjeta-subtitulo">
            Delitos criminales registrados por linaje, según los filtros de arriba. No incluye los
            linajes no criminales (documentos, traslados, juicios civiles, etc.).
          </div>
        </div>
        <div class="mapa-tarjeta-divisor"></div>
        <div id="crimenesPorTipo"></div>
      </div>

      <div class="mapa-tarjeta mapa-tarjeta--compacta">
        <div class="mapa-tarjeta-encabezado">
          <div class="mapa-tarjeta-titulo">Relación entre crímenes</div>
          <div class="mapa-tarjeta-subtitulo">
            Crímenes cometidos en un mismo caso · Selecciona los filtros para una visión granular
          </div>
        </div>
        <div class="mapa-tarjeta-divisor"></div>
        <div id="grafoRelacionContenedor"></div>
      </div>
    </div>

    <script>
      import { inicializarDashboard } from '../../scripts/charts/TiempoCrimenesMapa.js';
      import { crearCrimenesPorTipo } from '../../scripts/charts/CrimenesPorTipo.js';
      import { crearRelacionCrimenes } from '../../scripts/charts/RelacionCrimenes.js';

      inicializarDashboard();

      const btnVistaLugar = document.getElementById('btn-vista-lugar')!;
      const btnVistaCrimenes = document.getElementById('btn-vista-crimenes')!;
      const vistaLugar = document.getElementById('vista-lugar')!;
      const vistaCrimenes = document.getElementById('vista-crimenes')!;

      let vistaCrimenesInicializada = false;

      function mostrarVista(vista: 'lugar' | 'crimenes') {
        const esLugar = vista === 'lugar';
        vistaLugar.classList.toggle('mapa-vista--oculta', !esLugar);
        vistaCrimenes.classList.toggle('mapa-vista--oculta', esLugar);
        btnVistaLugar.classList.toggle('btn-mapa--activo', esLugar);
        btnVistaCrimenes.classList.toggle('btn-mapa--activo', !esLugar);

        if (!esLugar && !vistaCrimenesInicializada) {
          vistaCrimenesInicializada = true;
          crearCrimenesPorTipo('crimenesPorTipo');
          crearRelacionCrimenes('grafoRelacionContenedor');
        }
      }

      btnVistaLugar.addEventListener('click', () => mostrarVista('lugar'));
      btnVistaCrimenes.addEventListener('click', () => mostrarVista('crimenes'));
    </script>
  </main>
</BaseLayout>
