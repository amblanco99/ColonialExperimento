---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Primera página con gráfico. De los tres que llamaba aboutmain.js, aquí solo
// existe #tipoCaso, así que solo se llama a crearTiposCasos. crearConteoCrimenes
// y crearLinaje se quedan fuera: sus contenedores (#conteoCrimenes, #chartLinaje)
// están en delitos.html, no aquí.
//
// El import del <script> apunta todavía a src/charts/. El módulo se mueve a
// src/scripts/*.ts en la fase 5a; hasta entonces esta ruta es la buena.
---

<BaseLayout title="Fuentes" active="about">
  <main class="container">
    <h1 class="section-mainTitle">Fuentes</h1>

    <p>
      La información que alimenta las bases de datos proviene de los archivos judiciales del
      Archivo General de la Nación (AGN) y del Archivo Histórico de Bogotá (AHB). Los expedientes
      judiciales fueron digitalizados y puestos a disposición del público en línea por estas
      instituciones. La información se obtuvo a partir de la revisión sistemática de los
      expedientes, registrando los datos relevantes en una base de datos relacional.
    </p>

    <section>
      <h2>Tipos de Caso</h2>
      <p>
        Aquí se explica los tipos de casos que se encuentran en el archivo, y se actualiza el
        número de casos totales y que tengan la codificación de un crímen
      </p>

      <div class="legend">
        <div class="legend-item">
          <div class="color-box azul"></div>
          <span>No es un proceso penal con delito identificable</span>
        </div>

        <div class="legend-item">
          <div class="color-box rosa"></div>
          <span>Proceso judicial criminal identificable</span>
        </div>
      </div>

      <div id="tipoCaso"></div>
    </section>

    <script>
      import { crearTiposCasos } from '../../charts/TiposCasos.js';

      crearTiposCasos();
    </script>
  </main>
</BaseLayout>
