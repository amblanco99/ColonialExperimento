---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Cadena de personasDetalleMain.js, en el mismo orden. La global la pone
// BaseLayout; estas nueve son de la página. La fase 4b las repunta a
// src/styles/pages/.
import '../../style/tooltips.css';
import '../../style/botones.css';
import '../../style/graficos.css';
import '../../style/filtros-chip.css';
import '../../style/mariposa.css';
import '../../style/apilado.css';
import '../../style/lineas.css';
import '../../style/sunburst.css';
import '../../style/dashboard.css';

// El carrusel pw-* que describía el plan ya no existe: origin/main lo sustituyó
// por este conmutador de vistas. Ya no hay acoplamiento por data-index con un
// array de renderizadores; initVistaToggle recibe los ids explícitos.
//
// #personasFiltrosTop es obligatorio: PersonasDashboard.js:13 hace return si no
// lo encuentra, y con él no se dibuja ningún gráfico.
---

<BaseLayout title="Personas" active="personas">
  <main class="container personas-main-ancho">
    <h1 class="section-mainTitle">Personas</h1>

    <div class="vista-toggle" role="tablist" aria-label="Modo de visualización">
      <button
        type="button"
        class="vista-toggle-btn vista-toggle-btn--activo"
        id="vistaBtnDashboard"
        role="tab"
        aria-selected="true"
        aria-controls="vistaDashboard">Dashboard</button
      >
      <button
        type="button"
        class="vista-toggle-btn"
        id="vistaBtnHistoria"
        role="tab"
        aria-selected="false"
        aria-controls="vistaHistoria">Historia</button
      >
    </div>

    <section class="personas-dashboard-seccion" id="vistaDashboard">
      <div id="personasFiltrosTop" class="personas-filtros-top"></div>

      <div class="personas-grid">
        <div class="personas-columna">
          <div class="personas-tarjeta">
            <div id="butterflyFiltros"></div>
            <div id="butterflyGenero"></div>
          </div>
        </div>

        <div class="personas-columna">
          <div class="personas-tarjeta">
            <div id="participacionLineaGeneral"></div>
          </div>

          <div class="personas-tarjeta">
            <div id="delitosGeneroSunburst"></div>
          </div>
        </div>
      </div>
    </section>

    <section class="vista-historia" id="vistaHistoria" hidden>
      <p class="vista-historia-placeholder">Próximamente.</p>
    </section>

    <script>
      import { crearPersonasDashboard } from '../../charts/PersonasDashboard.js';
      import { initVistaToggle } from '../../ui/vistaToggle.js';

      crearPersonasDashboard();

      initVistaToggle({
        botones: ['vistaBtnDashboard', 'vistaBtnHistoria'],
        vistas: ['vistaDashboard', 'vistaHistoria'],
      });
    </script>
  </main>
</BaseLayout>
